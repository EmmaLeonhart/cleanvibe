          },
          {
            "by": "assembly",
            "says": "From many places and peoples we come to this house of prayer."
          },
          {
            "by": "presider",
            "says": "In this time and place, we meet in the presence of the living God."
          },
          {
            "by": "assembly",
            "says": "The Creator who is the source of all that is, seen and unseen."
          },
          {
            "by": "presider",
            "says": "In this time and place, the risen Christ stands in our midst."
          },
          {
            "by": "assembly",
            "says": "Our Companion who walks with us and with all peoples on the path of reconciliation."
          },
          {
            "by": "presider",
            "says": "In this time and place, God's Holy Spirit breathes in and through us."
          },
          {
            "by": "assembly",
            "says": "We are being made new by the holy and life-giving Trinity, one God."
          }
        ]
